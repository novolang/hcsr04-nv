// hcsr04_tests — the driver over a double of the module: a clock that
// every read of the timer advances, and an Echo pin whose level follows
// the trigger the way the HC-SR04 sheet ("Ultrasonic Ranging Module
// HC-SR04", ElecFreaks) describes: Trig high for at least 10 us, then a
// burst, then Echo high for a time proportional to the distance.
//
// The double's state `st`, all in microseconds on its own clock:
//   0   the clock                     1   Trig's level now
//   2   when Trig last rose           3   when Trig last fell
//   4   how many times Trig rose      5   the first Trig-high time that was too short
//   10  Echo's delay after Trig falls 11  the pulse width Echo is high for
//   12  1 when a module answers      13  1 when Echo is stuck high
//   14  Echo is high until this time (the tail of an earlier pulse)
//   20  when Echo rises (set by the trigger)   21  when Echo falls
// `log` keeps the rise times of Trig, `pinmode` the direction of each pin
// and the order the pins were driven in.

use std.test
use embedded_hal.{ BoardGpio, BoardTimer, GpioInAsync, GpioOut, Timer }
use dev_range.{ RangeReading, RangeStatus, Rangefinder, range_has_distance }
use hcsr04
use hcsr04.{ HcSr04 }

struct World
    st: HashMap<Int, Int>
    log: HashMap<Int, Int>
    pinmode: HashMap<Int, Int>
    order: HashMap<Int, Int>

fn at(m: HashMap<Int, Int>, k: Int) -> Int
    m.get(k) ?? 0

fn world() -> World
    let w = World { st: HashMap.new(), log: HashMap.new(), pinmode: HashMap.new(), order: HashMap.new() }
    w.st.insert(10, 400)
    w.st.insert(11, 5830)
    w.st.insert(12, 1)
    w

// The clock and the delays.  Every read of the tick costs 1 us, as a
// poll of a real timer does, so a wait always ends.
struct FakeTimer
    w: World

impl Timer for FakeTimer
    fn delay_ms(self, ms: Int) [hw]
        self.w.st.insert(0, at(self.w.st, 0) + ms * 1000)

    fn delay_us(self, us: Int) [hw]
        self.w.st.insert(0, at(self.w.st, 0) + us)

    fn ticks_ms(self) -> Int [hw]
        at(self.w.st, 0) / 1000

    fn ticks_us(self) -> Int [hw]
        let n = at(self.w.st, 0) + 1
        self.w.st.insert(0, n)
        n

// The pins: Trig is pin 3, Echo is pin 4.  A rising Trig records its
// time; a falling Trig starts the burst, and if a module answers, Echo
// rises `st[10]` us later and stays high `st[11]` us.
struct FakePins
    w: World

impl GpioOut for FakePins
    fn mode(self, pin: Int, dir: Int) [hw]
        self.w.pinmode.insert(pin, dir)
        let n = at(self.w.order, 0)
        self.w.order.insert(n + 1, pin * 10 + dir)
        self.w.order.insert(0, n + 1)

    fn set(self, pin: Int, val: Int) [hw]
        let now = at(self.w.st, 0)
        let n = at(self.w.order, 0)
        self.w.order.insert(n + 1, pin * 10 + 100 + val)
        self.w.order.insert(0, n + 1)
        if pin != 3
            return
        if val == 1 and at(self.w.st, 1) == 0
            self.w.st.insert(2, now)
            self.w.log.insert(at(self.w.st, 4), now)
            self.w.st.insert(4, at(self.w.st, 4) + 1)
        if val == 0 and at(self.w.st, 1) == 1
            self.w.st.insert(3, now)
            if now - at(self.w.st, 2) < 10 and at(self.w.st, 5) == 0
                self.w.st.insert(5, now - at(self.w.st, 2))
            if at(self.w.st, 12) == 1
                self.w.st.insert(20, now + at(self.w.st, 10))
                self.w.st.insert(21, now + at(self.w.st, 10) + at(self.w.st, 11))
        self.w.st.insert(1, val)

    fn get(self, pin: Int) -> Int [hw]
        let now = at(self.w.st, 0)
        if at(self.w.st, 13) == 1
            return 1
        if now < at(self.w.st, 14)
            return 1
        if now >= at(self.w.st, 20) and now < at(self.w.st, 21)
            return 1
        0

// Echo's edges as a board that parks a task on them delivers them: the
// task wakes at the rise `st[20]` and at the fall `st[21]`, and the number
// of parks is `st[30]`.
struct FakeEdges
    w: World

impl GpioInAsync for FakeEdges
    @tier(rt)
    async fn wait_for_edge(self, pin: Int, edge: Int) -> Int [hw]
        self.w.st.insert(30, at(self.w.st, 30) + 1)
        if edge == 0
            self.w.st.insert(0, at(self.w.st, 20))
            return 1
        self.w.st.insert(0, at(self.w.st, 21))
        0

fn status_of(o: ?RangeReading) -> RangeStatus
    match o
        Some(r) => r.status
        None    => RangeStatus.RangeFault

fn mm_of(o: ?RangeReading) -> Int
    match o
        Some(r) => r.mm
        None    => -99999

fn abs(v: Int) -> Int
    if v < 0
        return 0 - v
    v

// ── Conversions ──────────────────────────────────────────────────────

@test
fn test_the_data_sheet_conversion_is_58_us_to_the_centimetre() [io, hw]
    test.assert_eq(hcsr04.mm_of_echo_us(58, 343000), 10)
    test.assert_eq(hcsr04.mm_of_echo_us(5830, 343000), 1000)
    test.assert_eq(hcsr04.mm_of_echo_us(5882, 340000), 1000)
    test.assert_eq(hcsr04.mm_of_echo_us(23324, 343000), 4000)

@test
fn test_a_pulse_or_a_speed_that_is_not_positive_is_no_distance() [io, hw]
    test.assert_eq(hcsr04.mm_of_echo_us(0, 343000), 0)
    test.assert_eq(hcsr04.mm_of_echo_us(-5, 343000), 0)
    test.assert_eq(hcsr04.mm_of_echo_us(5830, 0), 0)
    test.assert_eq(hcsr04.mm_of_echo_us(5830, -1), 0)

@test
fn test_the_speed_of_sound_follows_the_temperature() [io, hw]
    test.assert_eq(hcsr04.speed_of_sound_mm_s(0), 331300)
    test.assert_eq(hcsr04.speed_of_sound_mm_s(20000), 343420)
    test.assert_eq(hcsr04.speed_of_sound_mm_s(-20000), 319180)
    test.assert_eq(hcsr04.speed_of_sound_mm_s(35500), 352813)

@test
fn test_a_warm_room_reads_a_shorter_distance_than_the_default_speed() [io, hw]
    let cold = hcsr04.mm_of_echo_us(5830, hcsr04.speed_of_sound_mm_s(0))
    let warm = hcsr04.mm_of_echo_us(5830, hcsr04.speed_of_sound_mm_s(30000))
    test.assert_eq(cold, 966)
    test.assert_eq(warm, 1019)

@test
fn test_the_reading_of_a_pulse() [io, hw]
    let v = hcsr04.reading_of(5830, 343000)
    test.assert_eq(v.mm, 1000)
    test.assert(v.status == RangeStatus.RangeValid)
    test.assert(range_has_distance(v))
    let edge_lo = hcsr04.reading_of(117, 343000)
    test.assert_eq(edge_lo.mm, 20)
    test.assert(edge_lo.status == RangeStatus.RangeValid)
    let edge_hi = hcsr04.reading_of(23300, 343000)
    test.assert_eq(edge_hi.mm, 3996)
    test.assert(edge_hi.status == RangeStatus.RangeValid)

@test
fn test_a_pulse_outside_2_cm_to_4_m_is_out_of_range_with_no_distance() [io, hw]
    let near = hcsr04.reading_of(100, 343000)
    test.assert_eq(near.mm, 0)
    test.assert(near.status == RangeStatus.RangeOutOfRange)
    let far = hcsr04.reading_of(23400, 343000)
    test.assert_eq(far.mm, 0)
    test.assert(far.status == RangeStatus.RangeOutOfRange)
    let zero = hcsr04.reading_of(0, 343000)
    test.assert(zero.status == RangeStatus.RangeOutOfRange)
    test.assert(not range_has_distance(zero))

@test
fn test_a_38_ms_pulse_is_no_target_and_a_stuck_line_is_a_fault() [io, hw]
    let none = hcsr04.reading_of(38000, 343000)
    test.assert_eq(none.mm, 0)
    test.assert(none.status == RangeStatus.RangeNoTarget)
    test.assert(hcsr04.reading_of(41000, 343000).status == RangeStatus.RangeNoTarget)
    test.assert(hcsr04.reading_of(37999, 343000).status == RangeStatus.RangeOutOfRange)
    let stuck = hcsr04.reading_of(-2, 343000)
    test.assert_eq(stuck.mm, 0)
    test.assert(stuck.status == RangeStatus.RangeFault)

@test
fn test_the_cycle_wait() [io, hw]
    test.assert_eq(hcsr04.cycle_wait_us(100, -1), 0)
    test.assert_eq(hcsr04.cycle_wait_us(10000, 0), 50000)
    test.assert_eq(hcsr04.cycle_wait_us(60000, 0), 0)
    test.assert_eq(hcsr04.cycle_wait_us(90000, 0), 0)
    test.assert_eq(hcsr04.cycle_wait_us(50, 100), 60000)

// ── The pins and the timer ───────────────────────────────────────────

@test
fn test_wait_level_answers_the_tick_of_the_level_or_minus_one() [io, hw]
    let w = world()
    w.st.insert(20, 50)
    w.st.insert(21, 200)
    let t = FakeTimer { w: w }
    let g = FakePins { w: w }
    let seen = hcsr04.wait_level(g, t, 4, 1, 1000)
    test.assert(seen >= 50 and seen <= 53)
    let gone = hcsr04.wait_level(g, t, 4, 0, 1000)
    test.assert(gone >= 200 and gone <= 203)
    let w2 = world()
    let miss = hcsr04.wait_level(FakePins { w: w2 }, FakeTimer { w: w2 }, 4, 1, 300)
    test.assert_eq(miss, -1)
    test.assert(at(w2.st, 0) >= 300)

@test
fn test_the_pins_are_set_up_with_trig_low_before_it_is_an_output() [io, hw]
    let w = world()
    hcsr04.pins_setup(FakePins { w: w }, 3, 4)
    test.assert_eq(at(w.order, 0), 3)
    test.assert_eq(at(w.order, 1), 100 + 30 + 0)
    test.assert_eq(at(w.order, 2), 31)
    test.assert_eq(at(w.order, 3), 40)
    test.assert_eq(at(w.pinmode, 3), 1)
    test.assert_eq(at(w.pinmode, 4), 0)

@test
fn test_pulse_width_times_an_echo_that_rose_until_it_falls_and_caps_at_38_ms() [io, hw]
    // Echo high from tick 50 to tick 200: timed from the rise the caller names.
    let w = world()
    w.st.insert(20, 50)
    w.st.insert(21, 200)
    w.st.insert(0, 50)
    let width = hcsr04.pulse_width(FakePins { w: w }, FakeTimer { w: w }, 4, 50)
    test.assert(abs(width - 150) <= 3)
    // Still high past 38 ms: the wait ends there and answers the cap.
    let w2 = world()
    w2.st.insert(20, 0)
    w2.st.insert(21, 90000)
    test.assert_eq(hcsr04.pulse_width(FakePins { w: w2 }, FakeTimer { w: w2 }, 4, 0), 38000)
    // A fall seen a tick after 38 ms is the cap as well.
    let w3 = world()
    w3.st.insert(20, 0)
    w3.st.insert(21, 38002)
    test.assert_eq(hcsr04.pulse_width(FakePins { w: w3 }, FakeTimer { w: w3 }, 4, 0), 38000)

// ── One measurement ──────────────────────────────────────────────────

@test
fn test_a_metre_measures_5830_us_to_within_the_poll() [io, hw]
    let w = world()
    let width = hcsr04.measure(FakePins { w: w }, FakeTimer { w: w }, 3, 4, false)
    test.assert(abs(width - 5830) <= 3)
    test.assert_eq(at(w.st, 4), 1)

@test
fn test_the_trigger_pulse_is_at_least_10_us() [io, hw]
    let w = world()
    let _ = hcsr04.measure(FakePins { w: w }, FakeTimer { w: w }, 3, 4, false)
    test.assert(at(w.st, 3) - at(w.st, 2) >= 12)
    test.assert_eq(at(w.st, 5), 0)
    test.assert_eq(at(w.st, 1), 0)

@test
fn test_a_module_that_raises_echo_late_is_still_timed_from_the_rise() [io, hw]
    let w = world()
    w.st.insert(10, 1500)
    w.st.insert(11, 2915)
    let width = hcsr04.measure(FakePins { w: w }, FakeTimer { w: w }, 3, 4, false)
    test.assert(abs(width - 2915) <= 3)

@test
fn test_no_target_is_a_pulse_of_38_ms_and_the_measurement_stops_there() [io, hw]
    let w = world()
    w.st.insert(11, 38200)
    let width = hcsr04.measure(FakePins { w: w }, FakeTimer { w: w }, 3, 4, false)
    test.assert_eq(width, 38000)
    test.assert(hcsr04.reading_of(width, 343000).status == RangeStatus.RangeNoTarget)

@test
fn test_a_pulse_that_falls_a_tick_after_38_ms_is_capped_at_38_ms() [io, hw]
    let w = world()
    w.st.insert(11, 38001)
    let width = hcsr04.measure(FakePins { w: w }, FakeTimer { w: w }, 3, 4, false)
    test.assert_eq(width, 38000)

@test
fn test_a_pulse_just_under_38_ms_is_a_distance_out_of_range() [io, hw]
    let w = world()
    w.st.insert(11, 30000)
    let width = hcsr04.measure(FakePins { w: w }, FakeTimer { w: w }, 3, 4, false)
    test.assert(abs(width - 30000) <= 3)
    test.assert(hcsr04.reading_of(width, 343000).status == RangeStatus.RangeOutOfRange)

@test
fn test_a_module_that_does_not_raise_echo_is_absent_after_5_ms() [io, hw]
    let w = world()
    w.st.insert(12, 0)
    let width = hcsr04.measure(FakePins { w: w }, FakeTimer { w: w }, 3, 4, false)
    test.assert_eq(width, -1)
    test.assert(at(w.st, 0) >= 5000)
    test.assert_eq(at(w.st, 4), 1)

@test
fn test_an_echo_line_stuck_high_is_a_fault_and_no_trigger_is_fired() [io, hw]
    let w = world()
    w.st.insert(13, 1)
    let width = hcsr04.measure(FakePins { w: w }, FakeTimer { w: w }, 3, 4, false)
    test.assert_eq(width, -2)
    test.assert_eq(at(w.st, 4), 0)
    test.assert(at(w.st, 0) >= 50000)

@test
fn test_the_tail_of_the_last_pulse_is_waited_out_before_the_trigger() [io, hw]
    let w = world()
    w.st.insert(14, 20000)
    let width = hcsr04.measure(FakePins { w: w }, FakeTimer { w: w }, 3, 4, false)
    test.assert(abs(width - 5830) <= 3)
    test.assert(at(w.log, 0) >= 20000)

@test
fn test_a_padded_measurement_waits_out_the_60_ms_cycle() [io, hw]
    let w = world()
    let g = FakePins { w: w }
    let t = FakeTimer { w: w }
    let _a = hcsr04.measure(g, t, 3, 4, true)
    let _b = hcsr04.measure(g, t, 3, 4, true)
    test.assert_eq(at(w.st, 4), 2)
    test.assert(at(w.log, 1) - at(w.log, 0) >= 60000)
    test.assert(at(w.log, 1) - at(w.log, 0) <= 60100)

@test
fn test_an_unpadded_measurement_leaves_the_cycle_to_the_caller() [io, hw]
    let w = world()
    let g = FakePins { w: w }
    let t = FakeTimer { w: w }
    let _a = hcsr04.measure(g, t, 3, 4, false)
    let _b = hcsr04.measure(g, t, 3, 4, false)
    test.assert(at(w.log, 1) - at(w.log, 0) < 10000)

@test
fn test_a_padded_measurement_of_a_missing_module_is_padded_too() [io, hw]
    let w = world()
    w.st.insert(12, 0)
    let g = FakePins { w: w }
    let t = FakeTimer { w: w }
    let _a = hcsr04.measure(g, t, 3, 4, true)
    test.assert(at(w.st, 0) - at(w.log, 0) >= 60000)

@test
fn test_a_no_target_measurement_is_padded_to_the_cycle_from_the_trigger() [io, hw]
    let w = world()
    w.st.insert(11, 38200)
    let g = FakePins { w: w }
    let t = FakeTimer { w: w }
    let width = hcsr04.measure(g, t, 3, 4, true)
    test.assert_eq(width, 38000)
    test.assert(at(w.st, 0) - at(w.log, 0) >= 60000)

@test
fn test_the_reading_of_a_measurement() [io, hw]
    let w = world()
    let width = hcsr04.measure(FakePins { w: w }, FakeTimer { w: w }, 3, 4, false)
    test.assert(abs(mm_of(hcsr04.reading_opt(width, 343000)) - 1000) <= 1)
    test.assert(hcsr04.reading_opt(-1, 343000) == None)
    test.assert(status_of(hcsr04.reading_opt(-2, 343000)) == RangeStatus.RangeFault)
    test.assert(status_of(hcsr04.reading_opt(38000, 343000)) == RangeStatus.RangeNoTarget)

// A function written against the trait alone, called on a `let`.
fn distance_of<R: Rangefinder>(r: R) -> ?RangeReading [hw]
    if r.range_start() < 0
        return None
    r.range_read()

@test
fn test_a_function_over_the_trait_reads_the_module_through_a_plain_parameter() [io, hw]
    let d = HcSr04.attach(BoardGpio { id: 0 }, BoardTimer { id: 0 }, 3, 4)
    test.assert(distance_of(d) == None)

// ── The type over the host's board handles ───────────────────────────
//
// The host's pins read 0 and its timer runs, so a measurement finds no
// echo after the 5 ms wait: the module does not answer.  This runs the
// lines of the type that forward to the functions above.

@test
fn test_the_type_over_absent_hardware() [io, hw]
    let d = HcSr04.attach(BoardGpio { id: 0 }, BoardTimer { id: 0 }, 3, 4)
    d.begin()
    test.assert_eq(d.speed_mm_s(), 343000)
    test.assert_eq(d.range_max_mm(), 4000)
    test.assert_eq(d.range_start(), 0)
    test.assert(d.measure_fast() == None)
    test.assert_eq(d.echo_us(), -1)
    test.assert(d.range_read() == None)
    test.assert(d.range_read_after(10, 20) == None)
    test.assert(d.range_read_after(30, 20) == None)

@test
fn test_the_speed_is_set_directly_or_from_the_temperature() [io, hw]
    let d = HcSr04.attach(BoardGpio { id: 0 }, BoardTimer { id: 0 }, 3, 4)
    let a = d.with_speed_mm_s(340000)
    test.assert_eq(a.speed_mm_s(), 340000)
    test.assert_eq(a.with_speed_mm_s(0).speed_mm_s(), 340000)
    test.assert_eq(a.with_speed_mm_s(-5).speed_mm_s(), 340000)
    test.assert_eq(d.with_temperature_milli_c(0).speed_mm_s(), 331300)
    test.assert_eq(d.speed_mm_s(), 343000)
    test.assert_eq(hcsr04.with_speed(d, 300000).trigger, 3)
    test.assert_eq(hcsr04.with_speed(d, 300000).echo, 4)

// ── The awaited-edge form ────────────────────────────────────────────

fn pulse_world(rise_us: Int, width_us: Int) -> World
    let w = world()
    w.st.insert(20, rise_us)
    w.st.insert(21, rise_us + width_us)
    w

@test
fn test_the_awaited_edge_form_times_the_pulse_between_its_edges() [io, hw, async]
    let w = pulse_world(1000, 5830)
    let width = await hcsr04.echo_width_us(FakeEdges { w: w }, FakeTimer { w: w }, 4)
    test.assert_eq(width, 5830)
    // One park for each edge, and the pulse is the distance the sheet gives.
    test.assert_eq(at(w.st, 30), 2)
    let r = hcsr04.reading_of(width, 343000)
    test.assert_eq(r.mm, 1000)
    test.assert(r.status == RangeStatus.RangeValid)

@test
fn test_the_awaited_edge_form_ends_a_long_pulse_at_38_ms() [io, hw, async]
    let w = pulse_world(0, 45000)
    let width = await hcsr04.echo_width_us(FakeEdges { w: w }, FakeTimer { w: w }, 4)
    test.assert_eq(width, 38000)
    test.assert(hcsr04.reading_of(width, 343000).status == RangeStatus.RangeNoTarget)

@test
fn test_the_awaited_edge_form_keeps_a_pulse_of_exactly_38_ms() [io, hw, async]
    let w = pulse_world(250, 38000)
    test.assert_eq(await hcsr04.echo_width_us(FakeEdges { w: w }, FakeTimer { w: w }, 4), 38000)
